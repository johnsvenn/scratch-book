{
    "name": "scratchbook",
    "version": "0.1.9",
    "author": "John Elliott <johnsvenn@gmail.com>",
    "description": "An opinionated page based note taking application",
    "license": "MIT",
    "main": "./out/main/index.js",
    "scripts": {
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:win": "npm run build && electron-builder --win --config",
        "build:mac": "npm run build && electron-builder --mac --config",
        "build:linux": "npm run build && electron-builder --linux --config",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.{js,vue,json,css,scss,html}\"",
        "format:check": "prettier --check \"src/**/*.{js,vue,json,css,scss,html}\"",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.2.10",
        "@fontsource/roboto-mono": "^5.2.8",
        "adm-zip": "^0.5.16",
        "chokidar": "^3.6.0",
        "dompurify": "^3.3.3",
        "idb": "^8.0.3",
        "lucide-vue-next": "^0.577.0",
        "marked": "^17.0.4",
        "minisearch": "^7.2.0",
        "pinia": "^2.1.7",
        "vue-router": "^4.2.5",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^4.5.2",
        "@vitest/coverage-v8": "^3.0.0",
        "@vue/compiler-sfc": "^3.5.29",
        "@vue/test-utils": "^2.4.6",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "electron-vite": "^2.0.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.8.0",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.1",
        "sass": "^1.69.5",
        "vite": "^5.0.0",
        "vitest": "^3.0.0",
        "vue": "^3.4.0"
    },
    "build": {
        "productName": "ScratchBook",
        "appId": "com.johnsvenn.scratchbook",
        "directories": {
            "output": "build"
        },
        "mac": {
            "icon": "build/icons/icon.icns"
        },
        "win": {
            "icon": "build/icons/icon.ico"
        },
        "linux": {
            "icon": "build/icons"
        }
    }
}